# Docker Compose 部署基础配置
TZ=Asia/Shanghai
SPRING_PROFILES_ACTIVE=dev
ACTUATOR_EXPOSURE_INCLUDE=health
NACOS_SERVER_ADDR=host.docker.internal:8848
NACOS_NAMESPACE=dev

# 网关端口映射：宿主机 8800 -> 容器 8800。
# 默认会监听宿主机所有网卡；若外部无法访问，请优先检查云安全组、系统防火墙和服务器运营商端口策略。
GATEWAY_PUBLIC_PORT=8800
GATEWAY_SERVER_PORT=8800

# 后端微服务容器内端口通常不需要调整；只有端口冲突或做专项排查时再取消注释修改。
#AUTH_SERVER_PORT=8100
#USER_SERVER_PORT=8101
#PROBLEM_SERVER_PORT=8102
#SUBMISSION_SERVER_PORT=8103
#JUDGE_SERVER_PORT=8104
#CONTEST_SERVER_PORT=8105
#TRAINING_SERVER_PORT=8106
#DISCUSSION_SERVER_PORT=8107
#ACHIEVEMENT_SERVER_PORT=8108
#ANNOUNCEMENT_SERVER_PORT=8109

# 外部基础设施连接配置
# 在 Docker 容器内访问宿主机服务时可使用 host.docker.internal；生产环境也可以填写真实内网 IP 或域名。
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=replace_me
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=replace_me

# 判题任务分发复用共享 Redis Streams，不再需要 RabbitMQ 容器或 AMQP 配置。

# go-judge 判题节点容器配置
GOJUDGE_IMAGE=hnieoj/go-judge:dev
GOJUDGE_SHM_SIZE=512m
# 如需用本地 go-judge 源码构建镜像，请取消注释并填写 go-judge 项目目录；直接使用已有镜像时无需配置。
#GOJUDGE_SOURCE_DIR=/opt/hnieoj/go-judge

# 判题节点状态目录（宿主机）：identity.json（本地 Ed25519 私钥）、config.yaml、results/ 持久化于此。
# 宿主机目录与容器内状态目录必须可写；该目录不得只读，也不得挂入 go-judge-sandbox。
HNIEOJ_JUDGE_STATE_HOST_DIR=/data/oj/judge-node
HNIEOJ_JUDGE_STATE_DIR=/var/lib/hnieoj-judge-node
# Agent 实际读取 ${HNIEOJ_JUDGE_STATE_DIR}/config.yaml，配置文件由运维准备并受控只读挂载。
# 直连 Compose 前必须先在宿主机状态目录预置同名常规文件（0600），否则嵌套 bind 会把它创建为目录。
GOJUDGE_CONFIG_HOST_FILE=/etc/hnieoj/go-judge/config.yaml
# 一次性 Bootstrap：宿主机目录 0700、目录内 bootstrap.token 0600，整目录只读挂载。
# 挂载路径与 config.formal.example.yaml 的 bootstrap.tokenFile 一致（/etc/hnieoj/judge-node/bootstrap.token）。
HNIEOJ_JUDGE_BOOTSTRAP_HOST_DIR=/etc/hnieoj/judge-node
HNIEOJ_JUDGE_BOOTSTRAP_DIR=/etc/hnieoj/judge-node
HNIEOJ_JUDGE_BOOTSTRAP_TOKEN_FILE=/etc/hnieoj/judge-node/bootstrap.token
GOJUDGE_CACHE_DIR=/data/oj/judge-cache
# 判题节点不再读取 Nacos；节点非敏感运行参数统一写入节点本地 config.yaml。

# 后端内部安全配置
# replace_me 必须在真实部署前替换为高强度随机值。
HNIEOJ_INTERNAL_TOKEN=replace_me
HNIEOJ_JUDGE_JWT_SECRET=replace_me
# 节点 NODE_ACCESS 短期令牌 HMAC 密钥，仅运行时环境/文件注入，所有副本一致。
HNIEOJ_JUDGE_NODE_ACCESS_TOKEN_SECRET=replace_me

# 本地持久化资源目录
# HNIEOJ_PROBLEM_STORAGE_HOST_PATH 是宿主机目录，HNIEOJ_PROBLEM_STORAGE_ROOT 是容器内挂载路径。
HNIEOJ_PROBLEM_STORAGE_HOST_PATH=/data/oj/problems
HNIEOJ_PROBLEM_STORAGE_ROOT=/data/oj/problems
HNIEOJ_PROBLEM_IMAGE_URL_PREFIX=/oj/images
HNIEOJ_JUDGE_SECURITY_HOST_DIR=/etc/hnieoj/judge-security

# JVM 默认参数
JAVA_BASE_IMAGE=eclipse-temurin:17-jre-jammy
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC -Djava.security.egd=file:/dev/./urandom
