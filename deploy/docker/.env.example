# Compose deployment
TZ=Asia/Shanghai
SPRING_PROFILES_ACTIVE=dev
NACOS_SERVER_ADDR=106.54.177.244:8848
NACOS_NAMESPACE=dev

# Gateway exposure: external 8800 -> container 8800
GATEWAY_PUBLIC_PORT=8800
GATEWAY_SERVER_PORT=8800

# External infrastructure
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=replace_me
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=replace_me

# Use REDIS_HOST=redis when started by deploy-dev.sh redis-up.
# Use host.docker.internal or a real IP when Redis is managed outside this Compose project.
# Redis must stay private to the backend (never exposed to judge nodes or the public internet),
# with AOF enabled and maxmemory-policy noeviction.
REDIS_BIND_HOST=127.0.0.1
REDIS_PUBLIC_PORT=6379
REDIS_IMAGE=redis:7.4-alpine
REDIS_DATA_DIR=/opt/hnieoj/redis/data

# go-judge deployment
GOJUDGE_IMAGE=hnieoj/go-judge:dev
GOJUDGE_SHM_SIZE=512m
GOJUDGE_CONFIG_HOST_FILE=/etc/hnieoj/go-judge/config.yaml
GOJUDGE_CACHE_DIR=/data/oj/judge-cache
# 节点只访问后端 HTTPS 与本地沙箱：不连接 Nacos/RabbitMQ，也不持有共享主密钥。
# 远程后端必须 HTTPS；仅 localhost/127.0.0.1/::1 允许明文 HTTP。
HNIEOJ_BASE_URL=https://oj.example.com
# 容器内实际读取的逐节点凭证文件（对应 go-judge config.yaml 的 hnieoj.credential.tokenFile）。
HNIEOJ_CREDENTIAL_TOKEN_FILE=/etc/hnieoj/judge-node/credential.json
# 宿主凭证目录（0700，必须可写）：挂载为容器内目录，节点续期后以 0600 原子替换
# 目录内的 credential.json，因此不能只读或单文件挂载。
HNIEOJ_JUDGE_CREDENTIAL_HOST_DIR=/etc/hnieoj/judge-node

# Internal service security: nodes hold only per-node Bearer credentials; no global master key.
HNIEOJ_INTERNAL_TOKEN=replace_me
HNIEOJ_JUDGE_JWT_SECRET=replace_me

# Local persistent resources
HNIEOJ_PROBLEM_STORAGE_HOST_PATH=/data/oj/problems
HNIEOJ_PROBLEM_STORAGE_ROOT=/data/oj/problems
HNIEOJ_PROBLEM_IMAGE_URL_PREFIX=/oj/images

# JVM defaults
JAVA_BASE_IMAGE=eclipse-temurin:17-jre-jammy
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC -Djava.security.egd=file:/dev/./urandom
