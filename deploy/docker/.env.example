# Compose deployment
TZ=Asia/Shanghai
SPRING_PROFILES_ACTIVE=dev
NACOS_SERVER_ADDR=106.54.177.244:8848
NACOS_NAMESPACE=dev

# Gateway exposure: external 8800 -> container 8800
GATEWAY_PUBLIC_PORT=8800
GATEWAY_SERVER_PORT=8800

# External infrastructure
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=replace_me
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=replace_me

# Use RABBITMQ_HOST=rabbitmq when started by deploy-dev.sh rabbitmq-up.
# Use host.docker.internal or a real IP when RabbitMQ is managed outside this Compose project.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_PUBLIC_PORT=5672
RABBITMQ_MANAGEMENT_PUBLIC_PORT=15672
RABBITMQ_MANAGEMENT_URL=http://127.0.0.1:15672
RABBITMQ_MANAGEMENT_USERNAME=hnieoj_judge
RABBITMQ_MANAGEMENT_PASSWORD=replace_me
RABBITMQ_USERNAME=hnieoj_judge
RABBITMQ_PASSWORD=replace_me
RABBITMQ_VHOST=hnieoj
RABBITMQ_IMAGE=rabbitmq:4.2.7-management
RABBITMQ_DATA_DIR=/opt/hnieoj/rabbitmq/data

# go-judge deployment
GOJUDGE_IMAGE=hnieoj/go-judge:dev
GOJUDGE_PUBLIC_PORT=5050
GOJUDGE_SHM_SIZE=512m
GOJUDGE_CONFIG_HOST_FILE=/etc/hnieoj/go-judge/config.yaml
GOJUDGE_CACHE_DIR=/data/oj/judge-cache
HNIEOJ_JUDGE_NODE_REMOTE_CONFIG_ENABLED=true
HNIEOJ_JUDGE_NODE_NACOS_GROUP=HNIEOJ_JUDGE_GROUP
HNIEOJ_JUDGE_NODE_NACOS_DATA_ID=hnieoj-judge-node.yaml

# Internal service security
HNIEOJ_INTERNAL_TOKEN=replace_me
HNIEOJ_JUDGE_JWT_SECRET=replace_me
HNIEOJ_JUDGE_FORMAL_TOKEN_PUBLIC_KEY=
HNIEOJ_JUDGE_FORMAL_TOKEN_PUBLIC_KEY_PATH=/etc/hnieoj/judge-security/judge_formal_public.pem
HNIEOJ_JUDGE_FORMAL_TOKEN_PRIVATE_KEY_PATH=/etc/hnieoj/judge-security/judge_formal_private.pem
HNIEOJ_JUDGE_FORMAL_TOKEN_NACOS_DATA_ID=hnieoj-judge-formal-token.yaml
HNIEOJ_JUDGE_FORMAL_TOKEN_NACOS_GROUP=HNIEOJ_SECRET_GROUP

# Local persistent resources
HNIEOJ_PROBLEM_STORAGE_HOST_PATH=/data/oj/problems
HNIEOJ_PROBLEM_STORAGE_ROOT=/data/oj/problems
HNIEOJ_PROBLEM_IMAGE_URL_PREFIX=/oj/images
HNIEOJ_JUDGE_SECURITY_HOST_DIR=/etc/hnieoj/judge-security

# JVM defaults
JAVA_BASE_IMAGE=eclipse-temurin:17-jre-jammy
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC -Djava.security.egd=file:/dev/./urandom
